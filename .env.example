# ============================================
# SOET University Website - Environment Configuration
# ============================================
# SECURITY WARNING: This is an example file with placeholder values.
# Copy this file to .env and replace ALL placeholder values with your actual credentials.
# NEVER commit the actual .env file to version control!
# ============================================

# ============================================
# Server Configuration
# ============================================
# Environment: development, production, or test
NODE_ENV=development

# Port number for the server to listen on
PORT=3000

# Client URL for CORS configuration
CLIENT_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/database-name
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database-name
MONGODB_URI=your-mongodb-connection-string-here

# ============================================
# JWT (JSON Web Token) Configuration
# ============================================
# Secret key for signing JWT tokens - MUST be a strong, random string
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-here

# JWT token expiration time (e.g., 7d, 24h, 60m)
JWT_EXPIRE=7d

# ============================================
# Security Configuration
# ============================================
# Rate limiting window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per window per IP
RATE_LIMIT_MAX=100

# ============================================
# Email Configuration (SMTP)
# ============================================
# SMTP server host (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=your-smtp-host-here

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USER=your-email@example.com

# SMTP password or app-specific password
# For Gmail: Generate an app password at https://myaccount.google.com/apppasswords
SMTP_PASS=your-smtp-password-here

# Email address to use in the "From" field
FROM_EMAIL=noreply@soetuniversity.com

# Name to use in the "From" field
FROM_NAME=SOET University

# ============================================
# File Upload Configuration (Cloudinary)
# ============================================
# Cloudinary cloud name (found in your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name-here

# Cloudinary API key (found in your Cloudinary dashboard)
CLOUDINARY_API_KEY=your-cloudinary-api-key-here

# Cloudinary API secret (found in your Cloudinary dashboard)
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-here

# ============================================
# Admin Configuration
# ============================================
# Default admin email for initial setup
ADMIN_EMAIL=admin@soetuniversity.com

# Default admin password for initial setup
# IMPORTANT: Change this immediately after first login!
ADMIN_PASSWORD=change-this-password-immediately

# ============================================
# Other Configuration
# ============================================
# Number of bcrypt rounds for password hashing (10-12 recommended)
BCRYPT_ROUNDS=12

# Secret key for session management - MUST be a strong, random string
SESSION_SECRET=your-session-secret-key-here
